<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password - DashPro</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            background: linear-gradient(135deg, #1e3a8a 0%, #3730a3 50%, #581c87 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', sans-serif;
            position: relative;
            overflow: hidden;
            padding: 20px;
        }
        
        .floating-shapes {
            position: absolute;
            width: 100%;
            height: 100%;
            pointer-events: none;
            overflow: hidden;
        }
        
        .shape {
            position: absolute;
            background: rgba(255, 255, 255, 0.08);
            border-radius: 50%;
            animation: float 8s ease-in-out infinite;
        }
        
        .shape:nth-child(1) {
            width: 100px;
            height: 100px;
            top: 10%;
            left: 10%;
            animation-delay: 0s;
        }
        
        .shape:nth-child(2) {
            width: 150px;
            height: 150px;
            top: 60%;
            right: 15%;
            animation-delay: 2s;
        }
        
        .shape:nth-child(3) {
            width: 80px;
            height: 80px;
            bottom: 15%;
            left: 25%;
            animation-delay: 4s;
        }
        
        .shape:nth-child(4) {
            width: 120px;
            height: 120px;
            top: 30%;
            right: 30%;
            animation-delay: 1s;
        }
        
        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-30px) rotate(180deg); }
        }
        
        .forgot-container {
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(20px);
            border-radius: 24px;
            padding: 48px;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.2);
            width: 100%;
            max-width: 480px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            position: relative;
            z-index: 1;
            animation: slideUp 0.6s ease-out;
        }
        
        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .logo-section {
            text-align: center;
            margin-bottom: 40px;
        }
        
        .logo-icon {
            width: 100px;
            height: 100px;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
            box-shadow: 0 15px 35px rgba(99, 102, 241, 0.4);
            animation: pulse 2s infinite;
        }
        
        @keyframes pulse {
            0%, 100% { transform: scale(1); box-shadow: 0 15px 35px rgba(99, 102, 241, 0.4); }
            50% { transform: scale(1.05); box-shadow: 0 20px 45px rgba(99, 102, 241, 0.6); }
        }
        
        .forgot-title {
            font-size: 32px;
            font-weight: 800;
            color: #1f2937;
            margin-bottom: 12px;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .subtitle {
            color: #6b7280;
            font-size: 16px;
            font-weight: 500;
            line-height: 1.6;
        }
        
        .form-group {
            margin-bottom: 24px;
        }
        
        .form-label {
            display: block;
            font-weight: 700;
            color: #374151;
            margin-bottom: 10px;
            font-size: 15px;
        }
        
        .form-input {
            width: 100%;
            padding: 18px 20px;
            border: 2px solid #e5e7eb;
            border-radius: 12px;
            font-size: 16px;
            transition: all 0.3s ease;
            background: #f9fafb;
            font-weight: 500;
        }
        
        .form-input:focus {
            outline: none;
            border-color: #6366f1;
            background: white;
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
            transform: translateY(-2px);
        }
        
        .submit-btn {
            width: 100%;
            padding: 18px;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 17px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 8px;
            box-shadow: 0 10px 25px rgba(99, 102, 241, 0.3);
        }
        
        .submit-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(99, 102, 241, 0.4);
        }
        
        .submit-btn:active {
            transform: translateY(-1px);
        }
        
        .divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, #e5e7eb, transparent);
            margin: 32px 0;
        }
        
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #6366f1;
            text-decoration: none;
            font-weight: 600;
            font-size: 15px;
            transition: all 0.3s ease;
            padding: 12px 24px;
            border-radius: 10px;
            background: rgba(99, 102, 241, 0.05);
        }
        
        .back-link:hover {
            background: rgba(99, 102, 241, 0.1);
            transform: translateX(-4px);
        }
        
        .info-box {
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.08), rgba(139, 92, 246, 0.08));
            border-left: 4px solid #6366f1;
            padding: 16px 20px;
            border-radius: 10px;
            margin-bottom: 24px;
        }
        
        .info-box p {
            color: #4b5563;
            font-size: 14px;
            line-height: 1.6;
            margin: 0;
            font-weight: 500;
        }
        
        .info-box i {
            color: #6366f1;
            margin-right: 8px;
        }
    </style>
</head>
<body>
    <div class="floating-shapes">
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
    </div>
    
    <div class="forgot-container">
        <div class="logo-section">
            <div class="logo-icon">
                <i class="fas fa-key" style="font-size: 40px; color: white;"></i>
            </div>
            <h1 class="forgot-title">Forgot Password?</h1>
            <p class="subtitle">No worries! Enter your email address and we'll send you an OTP to reset your password.</p>
        </div>
        
        <div class="info-box">
            <p>
                <i class="fas fa-info-circle"></i>
                You will receive a 6-digit OTP code on your registered email address.
            </p>
        </div>
        
        <form action="/verify-email" method="POST">
            <div class="form-group">
                <label class="form-label">
                    <i class="fas fa-envelope" style="color: #6366f1; margin-right: 8px;"></i>
                    Email Address
                </label>
                <input type="email" name="email" class="form-input" placeholder="Enter your registered email" required autofocus>
            </div>
            
            <button type="submit" class="submit-btn">
                <i class="fas fa-paper-plane" style="margin-right: 10px;"></i>
                Send OTP Code
            </button>
        </form>
        
        <div class="divider"></div>
        
        <div style="text-align: center;">
            <a href="/" class="back-link">
                <i class="fas fa-arrow-left"></i>
                Back to Login
            </a>
        </div>
    </div>
    
    <script>
    // Toastify notifications
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
    Toastify({
      text: "✅ <%= successMessage %>",
      duration: 3000,
      close: true,
      gravity: "top",
      position: "right",
      stopOnFocus: true,
      style: {
        background: "linear-gradient(to right, #00b09b, #96c93d)",
        borderRadius: "12px",
        boxShadow: "0 10px 25px rgba(16, 185, 129, 0.3)",
        fontSize: "15px",
        fontWeight: "600",
        padding: "16px 20px"
      },
    }).showToast();
    <% } %>
    
    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
    Toastify({
      text: "❌ <%= errorMessage %>",
      duration: 4000,
      close: true,
      gravity: "top",
      position: "right",
      stopOnFocus: true,
      style: {
        background: "linear-gradient(to right, #ff5f6d, #ffc371)",
        borderRadius: "12px",
        boxShadow: "0 10px 25px rgba(239, 68, 68, 0.3)",
        fontSize: "15px",
        fontWeight: "600",
        padding: "16px 20px"
      },
    }).showToast();
    <% } %>
    </script>
</body>
</html>
